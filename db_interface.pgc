void db_connect(const char* _database_name) {
	EXEC SQL BEGIN DECLARE SECTION;
	const char* database_name = _database_name;
	const char* password = getenv(DATABASE_PASSWORD_ENVIRONMENT_VARIABLE);
	// const char* password = "watermelone";
	const char* upload_post_prepared_stmt = "INSERT INTO post(id, thread, id_in_thread, name, upload_timestamp, content, files[0], files[1], files[2], files[3], key) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);";
	const char* create_thread_prepared_stmt = "INSERT INTO thread(id, number_of_posts, permission_object_id) VALUES (?, 0, ?);";
	const char* mark_post_as_deleted_prepared_stmt = "UPDATE post SET deleted = true WHERE id = ?;";
	const char* mark_thread_as_deleted_prepared_stmt = "UPDATE thread SET deleted = true WHERE id = ?;";
	const char* create_account_prepared_stmt = "INSERT INTO account(id, username, password_hash, key) VALUES (?, ?, ?, ?);";
	const char* create_permission_group_stmt = "INSERT INTO permission_group(id, name) VALUES (?, ?)";
	const char* add_administrator_account_stmt = "INSERT INTO account(id, username, password_hash, key, administrator) VALUES (1, 'Administrator', ?, ?, 't');"
		;
	EXEC SQL END DECLARE SECTION;
	// printf("password: %s\n", password);
	if (password)
		printf("Found environment variable \"%s\"\n", DATABASE_PASSWORD_ENVIRONMENT_VARIABLE);
	else {
		fprintf(stderr, "Could not find environment variable \"%s\" required for the database connection password. Exiting.\n", DATABASE_PASSWORD_ENVIRONMENT_VARIABLE);
		exit(2);
	}
	EXEC SQL CONNECT TO :database_name USER "mediaboard_server" USING :password;
	printf("Connected!\n");
	EXEC SQL PREPARE upload_post_stmt FROM :upload_post_prepared_stmt;
	EXEC SQL PREPARE create_thread_stmt FROM :create_thread_prepared_stmt;
	EXEC SQL PREPARE mark_post_as_deleted_stmt FROM :mark_post_as_deleted_prepared_stmt;
	EXEC SQL PREPARE mark_thread_as_deleted_stmt FROM :mark_thread_as_deleted_prepared_stmt;
	EXEC SQL PREPARE create_account_prepared_stmt FROM :create_account_prepared_stmt;
	EXEC SQL PREPARE create_permission_group_stmt FROM :create_permission_group_stmt;
	EXEC SQL PREPARE add_administrator_account_stmt FROM :add_administrator_account_stmt;
}

void db_test() {
    EXEC SQL BEGIN DECLARE SECTION;
    char dbname[1024];
    EXEC SQL END DECLARE SECTION;

    EXEC SQL SELECT current_database() INTO :dbname;
    printf("current_database = %s\n", dbname);
}

void db_create_administrator(const char* _password) {
	EXEC SQL BEGIN DECLARE SECTION;
	const char* password = _password;
	char hashed_password[60+1];
	char key[8+1];

	EXEC SQL END DECLARE SECTION;
	EXEC SQL DELETE FROM permission_group_account WHERE account_id = 1; // account id 0 is reserved for Public (unregistered users). Id 1 is reserved for Administrator
	EXEC SQL DELETE FROM account WHERE username = 'Administrator';
	EXEC SQL SELECT crypt(:password, gen_salt('bf')) INTO :hashed_password;
	strncpy(key, &hashed_password[25], 8); // Copying 8 characters from the index 25 takes 4 characters from the salt and 4 from the hash
	key[8] = '\0';
	EXEC SQL EXECUTE add_administrator_account_stmt USING :hashed_password, :key;
	EXEC SQL INSERT INTO permission_group_account(group_id, account_id) VALUES (0, 1); // Add to the Administrators group. Administrator account ID is always 1 (defined in user.hpp)
	EXEC SQL COMMIT;
}

int db_store_post(int thread_id_, int id_in_thread_, const char name_[POST_MAX_NAME+1], time_t upload_timestamp_, const char* content_, char files[4][POST_MAX_FILE_NAME_WITH_UUID+1], int file_count, const char key_[KEY_LENGTH+1]) {
    EXEC SQL BEGIN DECLARE SECTION;
	int number_of_posts;
	int post_id;
	int thread_id = thread_id_;
	int id_in_thread = id_in_thread_;
	const char* name = name_;
	char upload_timestamp[20];
	const char* content = content_;
	const char* file_1 = files[0]; const int file_1_indicator = file_count - 1;
	const char* file_2 = files[1]; const int file_2_indicator = file_count - 2;
	const char* file_3 = files[2]; const int file_3_indicator = file_count - 3;
	const char* file_4 = files[3]; const int file_4_indicator = file_count - 4;
	const char* key = key_;
    EXEC SQL END DECLARE SECTION;
	EXEC SQL SELECT number_of_posts INTO :number_of_posts FROM thread WHERE id = :thread_id;
	EXEC SQL COMMIT;
	number_of_posts++;
	EXEC SQL UPDATE thread 
		SET number_of_posts = :number_of_posts
		WHERE id = :thread_id;
	// strcpy(data, data_);
	strftime(upload_timestamp, 20, "%Y-%m-%d %H:%M:%S", gmtime(&upload_timestamp_));
	printf("[DB Interface] Storing post\nName: %s\nTimestamp: %s\nContent: %s[END]\n", name, upload_timestamp, content);
	EXEC SQL SELECT nextval('post_id_seq') INTO :post_id;
	EXEC SQL EXECUTE upload_post_stmt USING :post_id, :thread_id, :id_in_thread, :name, :upload_timestamp, :content, :file_1 INDICATOR :file_1_indicator, :file_2 INDICATOR :file_2_indicator, :file_3 INDICATOR :file_3_indicator, :file_4 INDICATOR :file_4_indicator, :key;
	EXEC SQL COMMIT;
	return post_id;
}

int db_store_thread(int number_of_posts_, int _new_permission_object_id) {
	printf("Executing db_store_thread\n");
	EXEC SQL BEGIN DECLARE SECTION;
	int thread_id;
	int new_permission_object_id = _new_permission_object_id;
	// int number_of_posts = number_of_posts_;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL SELECT nextval('thread_id_seq') INTO :thread_id;
	EXEC SQL EXECUTE create_thread_stmt USING :thread_id, :new_permission_object_id;
	EXEC SQL COMMIT;
	return thread_id;
}

// void db_mark_message_as_deleted(int thread_id_, int post_id_) {
void db_mark_post_as_deleted(int post_id_) {
	EXEC SQL BEGIN DECLARE SECTION;
	// int thread_id = thread_id_;
	int post_id = post_id_;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL EXECUTE mark_post_as_deleted_stmt USING :post_id;
	EXEC SQL COMMIT;
}

void db_mark_thread_as_deleted(int _thread_id) {
	EXEC SQL BEGIN DECLARE SECTION;
	int thread_id = _thread_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL EXECUTE mark_thread_as_deleted_stmt USING :thread_id;
	EXEC SQL COMMIT;
}

int db_account_username_exists(const char* _username) {
	EXEC SQL BEGIN DECLARE SECTION;
	const char* username = _username;
	char username_exists;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL SELECT exists (SELECT 1 FROM account WHERE username = :username LIMIT 1) INTO :username_exists;
	EXEC SQL COMMIT;
	if (username_exists == 't')
		return 1;
	else
		return 0;
}

int db_store_account(const char* _username, const char* _password) {
	EXEC SQL BEGIN DECLARE SECTION;
	int account_id;
	const char* username = _username;
	const char* password = _password;
	char hashed_password[60+1];
	char key[8+1];
	EXEC SQL END DECLARE SECTION;
	printf("Calling db_store_account with username: %s, password: %s\n", username, password);
	EXEC SQL SELECT crypt(:password, gen_salt('bf')) INTO :hashed_password;
	EXEC SQL COMMIT;
	strncpy(key, &hashed_password[25], 8); // Copying 8 characters from the index 25 takes 4 characters from the salt and 4 from the hash
	key[8] = '\0';
	printf("hashed_password: %s\n", hashed_password);
	printf("key: %s\n", key);
	EXEC SQL SELECT nextval('account_id_seq') INTO :account_id;
	EXEC SQL EXECUTE create_account_prepared_stmt USING :account_id, :username, :hashed_password, :key;
	EXEC SQL COMMIT;
	return account_id;
}

const char db_fetch_key(char* _key, const char* _username, const char* _password) {
	EXEC SQL BEGIN DECLARE SECTION;
	const char* username = _username;
	const char* password = _password;
	char key[8+1];
	char hashed_password[61];
	char passwords_match;
	EXEC SQL END DECLARE SECTION;
	printf("Calling db_fetch_key with username: %s, password: %s\n", username, password);
	hashed_password[0] = '\0';
	EXEC SQL SELECT password_hash INTO :hashed_password FROM account WHERE username = :username;
	EXEC SQL COMMIT;
	if (hashed_password[0] == '\0')
		return '\0';
	else {
		printf("Username exists. hashed_password: %s\n", hashed_password);
		EXEC SQL SELECT (:hashed_password = crypt(:password, :hashed_password)) INTO :passwords_match;
		if (passwords_match == 't') {
			EXEC SQL SELECT key INTO :key FROM account WHERE username = :username;
			EXEC SQL COMMIT;
			strcpy(_key, key); // Copy fetched key into the pointer passed to db_fetch_key
		}
		EXEC SQL COMMIT;
		return passwords_match;
	}
}

int db_key_matches_account(const char* _key, const char* _username) {
	EXEC SQL BEGIN DECLARE SECTION;
	const char* username = _username;
	char key[8+1];
	char username_exists;
	EXEC SQL END DECLARE SECTION;
	printf("Calling db_key_matches_account with username: %s, key: %s\n", username, _key);
	EXEC SQL SELECT exists (SELECT 1 FROM account WHERE username = :username LIMIT 1) INTO :username_exists;
	EXEC SQL COMMIT;
	if (username_exists == 't') {
		EXEC SQL SELECT key INTO :key FROM account WHERE username = :username;
		EXEC SQL COMMIT;
		if (strcmp(key, _key) == 0)
			return 1;
		else
			return 0;
	}
	else
		return 0;
}

int db_account_matches_password(int _account_id, const char* _password) {
	EXEC SQL BEGIN DECLARE SECTION;
	int account_id = _account_id;
	const char* password = _password;
	char hashed_password[61];
	char passwords_match;
	EXEC SQL END DECLARE SECTION;
	hashed_password[0] = '\0';
	EXEC SQL SELECT password_hash INTO :hashed_password FROM account WHERE id = :account_id;
	EXEC SQL COMMIT;
	EXEC SQL SELECT (:hashed_password = crypt(:password, :hashed_password)) INTO :passwords_match;
	if (passwords_match == 't')
		return 1;
	else
		return 0;
}

char db_change_password(int _account_id, const char* _old_password, const char* _new_password) {
	EXEC SQL BEGIN DECLARE SECTION;
	int account_id = _account_id;
	const char* old_password = _old_password;
	const char* new_password = _new_password;
	char hashed_old_password[61];
	char hashed_new_password[61];
	char passwords_match;
	EXEC SQL END DECLARE SECTION;
	printf("Calling db_change_password with:\nclient ID: %d\nold_password: %s\nnew_password: %s\n", account_id, old_password, new_password);
	hashed_old_password[0] = '\0';
	EXEC SQL SELECT password_hash INTO :hashed_old_password FROM account WHERE id = :account_id;
	EXEC SQL COMMIT;
	if (hashed_old_password[0] == '\0')
		return '\0';
	else {
		printf("Username exists. hashed_password: %s\n", hashed_old_password);
		EXEC SQL SELECT (:hashed_old_password = crypt(:old_password, :hashed_old_password)) INTO :passwords_match;
		EXEC SQL COMMIT;
		if (passwords_match == 't') {
			EXEC SQL SELECT crypt(:new_password, gen_salt('bf')) INTO :hashed_new_password;
			EXEC SQL UPDATE account SET password_hash = :hashed_new_password WHERE id = :account_id;
		}
		EXEC SQL COMMIT;
		return passwords_match;
	}
}

struct db_thread_array* db_retrieve_threads() {
	static struct db_thread_array thread_list;
	initThreadArray(&thread_list, 100);
	EXEC SQL BEGIN DECLARE SECTION;
	int thread_id;
	int number_of_posts;
	char deleted;
	int permission_object_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE thread_getter CURSOR FOR
		SELECT id, number_of_posts, deleted, permission_object_id FROM thread
		ORDER BY id;
	EXEC SQL OPEN thread_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `thread_getter` has retreived all threads
	while (true) {
		EXEC SQL FETCH thread_getter INTO :thread_id, :number_of_posts, :deleted, :permission_object_id;
		struct db_thread_struct thread;
		thread.id = thread_id;
		thread.number_of_posts = number_of_posts;
		thread.deleted = deleted == 't';
		thread.permission_object_id = permission_object_id;
		insertToThreadArray(&thread_list, thread);
	}
	EXEC SQL CLOSE thread_getter;
	EXEC SQL COMMIT;
	return &thread_list;
}

// Runs on start-up. Reads every message from the database and inserts it into a list of db_post_struct.
struct db_post_array* db_retrieve_history() {
	static struct db_post_array post_history;
	initPostArray(&post_history, 1000);
	EXEC SQL BEGIN DECLARE SECTION;
	int post_id;
	int thread_id;
	int id_in_thread;
	unsigned int upload_epoch;
	VARCHAR post_name[POST_MAX_NAME+1];
	timestamp upload_timestamp;
	VARCHAR post_content[POST_MAX_CONTENT+1];
	char files[4][POST_MAX_FILE_NAME_WITH_UUID+1]; int file_indicators[4];
	char deleted;
	char key[KEY_LENGTH+1];
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE post_getter CURSOR FOR
		SELECT id, thread, id_in_thread, name, upload_timestamp, content, files[0], files[1], files[2], files[3], extract(epoch FROM upload_timestamp)::int AS upload_timestamp_int, deleted, key FROM post
		ORDER BY id;
	EXEC SQL OPEN post_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `post_getter` has retreived all posts
	while (true) {
		EXEC SQL FETCH post_getter INTO :post_id, :thread_id, :id_in_thread, :post_name, :upload_timestamp, :post_content, :files[0] INDICATOR :file_indicators[0], :files[1] INDICATOR :file_indicators[1], :files[2] INDICATOR :file_indicators[2], :files[3] INDICATOR :file_indicators[3], :upload_epoch, :deleted, :key;
		struct db_post_struct post;
		post.id = post_id;
		post.thread_id = thread_id;
		post.id_in_thread = id_in_thread;
		post.upload_timestamp = (time_t)upload_epoch;
		strcpy(post.name, post_name.arr);
		post.content = malloc(sizeof(char) * post_content.len + 1);
		strcpy(post.content, post_content.arr);
		int file_i;
		for (file_i = 0; file_i < 4; file_i++) {
			if (file_indicators[file_i] >= 0) {
				strcpy(post.files[file_i], files[file_i]);
			}
			else
				break;
		}
		post.number_of_files = file_i;
		post.deleted = deleted == 't'; // In Postgres 't' means true
		strcpy(post.key, key);
		insertToPostArray(&post_history, post);
	}
	EXEC SQL CLOSE post_getter;
	EXEC SQL COMMIT;
	return (&post_history);
}

int db_store_group(const char name_[GROUP_MAX_NAME+1]) {
    EXEC SQL BEGIN DECLARE SECTION;
	int group_id;
	const char* name = name_;
    EXEC SQL END DECLARE SECTION;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;
	printf("[DB Interface] Storing permission_group %s\n", name);
	EXEC SQL SELECT nextval('permission_group_id_seq') INTO :group_id;
	EXEC SQL EXECUTE create_permission_group_stmt USING :group_id, :name;
	EXEC SQL COMMIT;
	printf("[db_interface] Stored group with ID %d\n", group_id);
	return group_id;
}

void db_delete_group(int _group_id) {
    EXEC SQL BEGIN DECLARE SECTION;
	int permission_collection_id;
	int group_id = _group_id;
    EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE permission_collection_getter_to_delete_group CURSOR FOR
		SELECT id FROM permission_collection
		WHERE permission_group_id = :group_id;
	EXEC SQL OPEN permission_collection_getter_to_delete_group;
	EXEC SQL WHENEVER NOT FOUND DO BREAK;
	while (true) {
		EXEC SQL FETCH permission_collection_getter_to_delete_group INTO :permission_collection_id;
		EXEC SQL DELETE FROM permission_setting WHERE permission_collection_id = :permission_collection_id;
	}
	EXEC SQL CLOSE permission_collection_getter_to_delete_group;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;
	EXEC SQL DELETE FROM permission_collection WHERE permission_group_id = :group_id;
	EXEC SQL DELETE FROM permission_group_account WHERE group_id = :group_id;
	// EXEC SQL DELETE FROM permission_group_heirarchy WHERE permission_group = :group_id;
	EXEC SQL DELETE FROM permission_group WHERE id = :group_id;
	printf("Finished db_delete_group on group: %d\n", group_id);
	EXEC SQL COMMIT;
}

struct db_group_array* db_retrieve_groups(void) {
	static struct db_group_array groups;
	initGroupArray(&groups, 100);
	EXEC SQL BEGIN DECLARE SECTION;
	int id;
	char name[GROUP_MAX_NAME+1];
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE group_getter CURSOR FOR
		SELECT id, name FROM permission_group;
	EXEC SQL OPEN group_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `group_getter` has retreived all groups
	while (true) {
		EXEC SQL FETCH group_getter INTO :id, :name;
		struct db_group_struct group;
		group.id = id;
		strcpy(group.name, name);
		insertToGroupArray(&groups, group);
	}
	EXEC SQL CLOSE group_getter;
	EXEC SQL COMMIT;
	return (&groups);
}

struct db_group_heirarchy_array* db_retrieve_group_heirarchy(void) {
	static struct db_group_heirarchy_array group_heirarchy;
	initGroupHeirarchyArray(&group_heirarchy, 100);
	EXEC SQL BEGIN DECLARE SECTION;
	int rank;
	int group_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE group_heirarchy_getter CURSOR FOR
		SELECT rank, permission_group FROM permission_group_heirarchy
		ORDER BY rank;
	EXEC SQL OPEN group_heirarchy_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `group_heirarchy_getter` has retreived all groups
	while (true) {
		EXEC SQL FETCH group_heirarchy_getter INTO :rank, :group_id;
		struct db_group_heirarchy_struct group;
		group.rank = rank;
		group.group_id = group_id;
		insertToGroupHeirarchyArray(&group_heirarchy, group);
	}
	EXEC SQL CLOSE group_heirarchy_getter;
	EXEC SQL COMMIT;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;
	return (&group_heirarchy);
}

void db_update_group_heirarchy(struct db_group_heirarchy_array* group_heirarchy) {
	EXEC SQL DELETE FROM permission_group_heirarchy;
	EXEC SQL BEGIN DECLARE SECTION;
	int rank;
	int group_id;
	EXEC SQL END DECLARE SECTION;
	for (int i = 0; i < group_heirarchy->used /*number of groups*/; i++) {
		rank = group_heirarchy->array[i].rank;
		group_id = group_heirarchy->array[i].group_id;
		EXEC SQL INSERT INTO permission_group_heirarchy(rank, permission_group) VALUES (:rank, :group_id);
	}
	EXEC SQL COMMIT;
}

struct db_account_array* db_retrieve_accounts(void) {
	static struct db_account_array accounts;
	initAccountArray(&accounts, 500);
	EXEC SQL BEGIN DECLARE SECTION;
	int id;
	char username[ACCOUNT_MAX_USERNAME+1];
	char key[KEY_LENGTH+1];
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE account_getter CURSOR FOR
		SELECT id, username, key FROM account;
	EXEC SQL OPEN account_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `account_getter` has retreived all accounts
	while (true) {
		EXEC SQL FETCH account_getter INTO :id, :username, :key;
		struct db_account_struct account;
		account.id = id;
		strcpy(account.username, username);
		strcpy(account.key, key);
		insertToAccountArray(&accounts, account);
	}
	EXEC SQL CLOSE account_getter;
	EXEC SQL COMMIT;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;
	return (&accounts);
}

void db_add_member_to_group(int _user_id, int _group_id) {
	EXEC SQL BEGIN DECLARE SECTION;
	int group_id = _group_id;
	int user_id = _user_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL INSERT INTO permission_group_account(group_id, account_id) VALUES (:group_id, :user_id);
	EXEC SQL COMMIT;
}

void db_remove_member_from_group(int _user_id, int _group_id) {
	EXEC SQL BEGIN DECLARE SECTION;
	int group_id = _group_id;
	int user_id = _user_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DELETE FROM permission_group_account WHERE group_id = :group_id AND account_id = :user_id;
	EXEC SQL COMMIT;
}

struct db_group_member_array* db_retrieve_group_members(void) {
	static struct db_group_member_array group_members;
	initGroupMemberArray(&group_members, 500);
	EXEC SQL BEGIN DECLARE SECTION;
	int group_id;
	int account_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE group_member_getter CURSOR FOR
		SELECT group_id, account_id FROM permission_group_account;
	EXEC SQL OPEN group_member_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `group_member_getter` has retreived all groups
	while (true) {
		EXEC SQL FETCH group_member_getter INTO :group_id, :account_id;
		struct db_group_member_struct group_member;
		group_member.group_id = group_id;
		group_member.account_id = account_id;
		insertToGroupMemberArray(&group_members, group_member);
	}
	EXEC SQL CLOSE group_member_getter;
	EXEC SQL COMMIT;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;
	return (&group_members);
}

int db_get_unique_permission_object_id() {
	EXEC SQL BEGIN DECLARE SECTION;
	int new_permission_object_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL SELECT nextval('permission_object_id_seq') INTO :new_permission_object_id;
	EXEC SQL COMMIT;
	return new_permission_object_id;
}

struct db_permission_collection_array* db_retrieve_permission_collections_for_permission_object(int _permission_object_id) {
	static struct db_permission_collection_array permission_collections;
	initPermissionCollectionArray(&permission_collections, 50);
	EXEC SQL BEGIN DECLARE SECTION;
	int id;
	int permission_object_id = _permission_object_id;
	int group_id;
	// int group_id_indicator;
	int account_id;
	// int account_id_indicator;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE permission_collection_getter CURSOR FOR
		SELECT id, permission_group_id, account_id FROM permission_collection
		WHERE permission_object_id = :permission_object_id;
	EXEC SQL OPEN permission_collection_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `permission_collection_getter` has retreived all groups
	while (true) {
		EXEC SQL FETCH permission_collection_getter INTO :id, :group_id, :account_id;
		struct db_permission_collection_struct permission_collection;
		permission_collection.id = id;
		// permission_collection.permission_object_id = permission_object_id;
		/*
		if (group_id_indicator == 0) {
			permission_collection.group_id = group_id;
			permission_collection.account_id = -1;
		}
		else if (account_id_indicator == 0) {
			permission_collection.account_id = account_id;
			permission_collection.group_id = -1;
		}
		else {
			fprintf(stderr, "Error retrieving permission collection with ID %d (both group_id and account_id are null or truncated).\n", id);
			continue;
		}
		*/
		permission_collection.group_id = group_id;
		permission_collection.account_id = account_id;
		insertToPermissionCollectionArray(&permission_collections, permission_collection);
	}
	EXEC SQL CLOSE permission_collection_getter;
	EXEC SQL COMMIT;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;
	return (&permission_collections);
}

struct db_permission_setting_array* db_retrieve_permission_settings_for_permission_collection(int _permission_collection_id) {
	static struct db_permission_setting_array permission_settings;
	initPermissionSettingArray(&permission_settings, 50);
	EXEC SQL BEGIN DECLARE SECTION;
	int id;
	int permission_collection_id = _permission_collection_id;
	int permission_number;
	int setting;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE permission_setting_getter CURSOR FOR
		SELECT id, permission_number, setting FROM permission_setting
		WHERE permission_collection_id = :permission_collection_id;
	EXEC SQL OPEN permission_setting_getter;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `permission_setting_getter` has retreived all groups
	while (true) {
		EXEC SQL FETCH permission_setting_getter INTO :id, :permission_number, :setting;
		struct db_permission_setting_struct permission_setting;
		permission_setting.id = id;
		// permission_setting.permission_collection_id = permission_collection_id;
		permission_setting.permission_number = permission_number;
		permission_setting.setting = setting;
		insertToPermissionSettingArray(&permission_settings, permission_setting);
	}
	EXEC SQL CLOSE permission_setting_getter;
	EXEC SQL COMMIT;
	EXEC SQL WHENEVER NOT FOUND CONTINUE;
	return (&permission_settings);
}

int db_store_permission_collection(int _permission_object_id, int _user_id, int _group_id) {
	EXEC SQL BEGIN DECLARE SECTION;
	int new_permission_collection_id;
	int permission_object_id = _permission_object_id;
	int user_id = _user_id; 	int user_id_indicator = user_id > -1;
	int group_id = _group_id; 	int group_id_indicator = group_id > -1;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL SELECT nextval('permission_collection_id_seq') INTO :new_permission_collection_id;
	EXEC SQL INSERT INTO permission_collection(id, permission_object_id, account_id, permission_group_id) VALUES (:new_permission_collection_id, :permission_object_id, :user_id INDICATOR :user_id_indicator, :group_id INDICATOR :group_id_indicator);
	EXEC SQL COMMIT;
	return new_permission_collection_id;
}

void db_delete_permission_collection(int _permission_collection_id) {
	EXEC SQL BEGIN DECLARE SECTION;
	int permission_collection_id = _permission_collection_id;
	EXEC SQL END DECLARE SECTION;
	printf("deleting permission_collection %d`n", permission_collection_id);
	EXEC SQL DELETE FROM permission_collection WHERE id = :permission_collection_id;
	EXEC SQL COMMIT;
}

int db_store_permission_setting(int _permission_collection_id, int _permission_number, int _setting) {
	EXEC SQL BEGIN DECLARE SECTION;
	int new_permission_setting_id;
	int permission_collection_id = _permission_collection_id;
	int permission_number = _permission_number;
	int setting = _setting;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL SELECT nextval('permission_setting_id_seq') INTO :new_permission_setting_id;
	EXEC SQL INSERT INTO permission_setting(id, permission_collection_id, permission_number, setting) VALUES (:new_permission_setting_id, :permission_collection_id, :permission_number, :setting);
	EXEC SQL COMMIT;
	return new_permission_setting_id;
}

void db_update_permission_setting(int _permission_setting_id, int _setting) {
	EXEC SQL BEGIN DECLARE SECTION;
	int permission_setting_id = _permission_setting_id;
	int setting = _setting;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL UPDATE permission_setting SET setting = :setting WHERE id = :permission_setting_id;
	EXEC SQL COMMIT;
}

// TODO delete after 0.0.5 release
void db_make_migrations() {
	EXEC SQL BEGIN DECLARE SECTION;
	int thread_id;
	int permission_object_id;
	EXEC SQL END DECLARE SECTION;
	EXEC SQL DECLARE thread_getter_migrater CURSOR FOR
		SELECT id FROM thread
		ORDER BY id;
	EXEC SQL OPEN thread_getter_migrater;
	EXEC SQL WHENEVER NOT FOUND DO BREAK; // Exits the while loop when `thread_getter_migrater` has retreived all threads
	while (true) {
		EXEC SQL SELECT nextval('permission_object_id_seq') INTO :permission_object_id;
		EXEC SQL FETCH thread_getter_migrater INTO :thread_id;
		EXEC SQL UPDATE thread SET permission_object_id = :permission_object_id WHERE id = :thread_id;
	}
	EXEC SQL COMMIT;
}

void db_disconnect(void) {
	EXEC SQL DISCONNECT ALL;
}

void print_sqlca() {
    fprintf(stderr, "==== sqlce ====\n");
    fprintf(stderr, "sqlcode: %ld\n", sqlca.sqlcode);
    fprintf(stderr, "sqlerrm.sqlerrml: %d\n", sqlca.sqlerrm.sqlerrml);
    fprintf(stderr, "sqlerrm.sqlerrmc: %s\n", sqlca.sqlerrm.sqlerrmc);
    fprintf(stderr, "sqlerrd: %ld %ld %ld %ld %ld %ld\n", sqlca.sqlerrd[0],sqlca.sqlerrd[1],sqlca.sqlerrd[2],
                                                          sqlca.sqlerrd[3],sqlca.sqlerrd[4],sqlca.sqlerrd[5]);
    fprintf(stderr, "sqlwarn: %d %d %d %d %d %d %d %d\n", sqlca.sqlwarn[0], sqlca.sqlwarn[1], sqlca.sqlwarn[2],
                                                          sqlca.sqlwarn[3], sqlca.sqlwarn[4], sqlca.sqlwarn[5],
                                                          sqlca.sqlwarn[6], sqlca.sqlwarn[7]);
    fprintf(stderr, "sqlstate: %5s\n", sqlca.sqlstate);
    fprintf(stderr, "===============\n");
	printf("Terminating the program...\n");
	exit(1); // Stop the server when an SQL error is encountered. This is likely due to incorrect setup.
}
